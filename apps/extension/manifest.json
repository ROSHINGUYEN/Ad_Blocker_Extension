{
  "manifest_version": 3,
  "name": "SHIORI AD CLEANER",
  "version": "1.0.0",
  "description": "Smart Ad Blocking & Browser Protection - Clean Browsing. Smart Detection. User Privacy.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "SHIORI AD CLEANER"
  }
}
